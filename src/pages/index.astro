---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout>
  <div class="shell">
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Roger Hutchings, home">Roger Hutchin<span>.gs</span></a>
      <nav class="primary-nav" aria-label="Main navigation">
        <ul>
          <li><a href="#work">Work</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="page-title">
        <p class="eyebrow">Roger Hutchings — software engineer &amp; technical consultant</p>
        <h1 id="page-title">Making complex software easier to change.</h1>
        <p class="hero-intro">
          I work on complex web applications, mostly with TypeScript and React. I help teams untangle
          existing codebases, improve architecture and performance, and make technical decisions with
          confidence.
        </p>
        <div class="hero-bottom">
          <p class="availability">Open to selected freelance and consulting work.</p>
          <a class="text-link" href="#contact">Get in touch</a>
        </div>
      </section>

      <section class="section" id="work" aria-labelledby="work-label">
        <h2 class="section-label" id="work-label"><span>01.</span> I can help with</h2>
        <div class="entries">
          <article class="entry">
            <h3>Complex web applications</h3>
            <p>Building and improving React and TypeScript applications where the behaviour, workflows or integrations need careful thought.</p>
          </article>
          <article class="entry">
            <h3>Existing codebases</h3>
            <p>Understanding unfamiliar systems, simplifying awkward areas and making useful changes without a wholesale rewrite.</p>
          </article>
          <article class="entry">
            <h3>Architecture and performance</h3>
            <p>Investigating where a front end struggles, improving its structure and addressing the problems that matter to its users.</p>
          </article>
          <article class="entry">
            <h3>Technical leadership</h3>
            <p>Helping teams work through trade-offs, agree on a direction and turn decisions into practical engineering work.</p>
          </article>
        </div>
      </section>

      <section class="section" id="experience" aria-labelledby="experience-label">
        <h2 class="section-label" id="experience-label"><span>02.</span> Selected experience</h2>
        <div class="experience-list">
          <article class="experience">
            <h3>Kraken Technologies</h3>
            <p>Engineering work on complex operational software for the energy sector, drawing on experience in product development and technical leadership.</p>
          </article>
          <article class="experience">
            <h3>University of Oxford / Zooniverse</h3>
            <p>Building front-end interfaces for citizen-science projects, helping people contribute to scientific research through the web.</p>
          </article>
        </div>
      </section>

      <section class="section" id="about" aria-labelledby="about-label">
        <h2 class="section-label" id="about-label"><span>03.</span> A bit about me</h2>
        <p class="about-copy">
          My route into software began in journalism and took me through citizen science at the
          University of Oxford to product engineering at Kraken Technologies. I enjoy understanding
          complicated systems, making them clearer, and helping people build things that work well.
          I’m based in Oxfordshire, UK.
        </p>
      </section>

      <section class="section" id="contact" aria-labelledby="contact-label">
        <h2 class="section-label" id="contact-label"><span>04.</span> Get in touch</h2>
        <div>
          <p class="contact-copy">If you have a web application that needs building, improving or untangling, I’d be happy to hear about it.</p>
          <div class="contact-links">
            <!-- TODO: Add a direct email link once Roger supplies the address. -->
            <a class="text-link" href="https://www.linkedin.com/in/roger-hutchings" target="_blank" rel="noreferrer">LinkedIn</a>
            <a class="text-link" href="https://github.com/rogerhutchings" target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>Roger Hutchings · Oxfordshire, UK</p>
      <a href="#top">Back to top</a>
    </footer>
  </div>
</SiteLayout>

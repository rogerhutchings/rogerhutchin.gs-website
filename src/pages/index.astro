---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout>
    <div class="shell">
        <header class="site-header">
            <a class="wordmark" href="#top" aria-label="Roger Hutchings, home">
                <span class="wordmark-name">rogerhutchin</span>
                <span class="wordmark-dot">.</span>
                <span class="wordmark-domain">gs</span>
            </a>
            <nav class="primary-nav" aria-label="Main navigation">
                <ul>
                    <li>
                        <a href="#work">Work</a>
                    </li>
                    <li>
                        <a href="#about">About</a>
                    </li>
                    <li>
                        <a href="#contact">Contact</a>
                    </li>
                    <li>
                        <button
                            class="theme-toggle"
                            type="button"
                            aria-label="Dark theme"
                            aria-pressed="false"
                        >
                            <svg
                                data-theme-icon="light"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                                stroke-linecap="round"
                                aria-hidden="true"
                            >
                                <circle cx="12" cy="12" r="4" />
                                <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
                            </svg>
                            <svg
                                data-theme-icon="dark"
                                data-icon-hidden
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M20.2 15.7A8.5 8.5 0 0 1 8.3 3.8 8.5 8.5 0 1 0 20.2 15.7Z" />
                            </svg>
                        </button>
                    </li>
                </ul>
            </nav>
        </header>

        <script>
            const root = document.documentElement;
            const systemTheme = window.matchMedia(
                '(prefers-color-scheme: dark)',
            );
            let manualTheme = root.dataset.theme || null;
            let transitionTimeout: number | undefined;

            function syncThemeToggle() {
                const isDark =
                    (manualTheme ||
                        (systemTheme.matches ? 'dark' : 'light')) === 'dark';
                document
                    .querySelectorAll<HTMLButtonElement>('.theme-toggle')
                    .forEach((button) => {
                        button.setAttribute('aria-pressed', String(isDark));
                        button
                            .querySelector('[data-theme-icon="light"]')
                            ?.toggleAttribute('data-icon-hidden', isDark);
                        button
                            .querySelector('[data-theme-icon="dark"]')
                            ?.toggleAttribute('data-icon-hidden', !isDark);
                    });
                if (manualTheme) {
                    document
                        .querySelector('#theme-color-light')
                        ?.setAttribute('media', isDark ? 'not all' : 'all');
                    document
                        .querySelector('#theme-color-dark')
                        ?.setAttribute('media', isDark ? 'all' : 'not all');
                }
            }

            systemTheme.addEventListener('change', syncThemeToggle);
            document.addEventListener('click', (event) => {
                if (!(event.target instanceof Element)) return;
                if (!event.target.closest('.theme-toggle')) return;

                root.classList.add('theme-transition');
                manualTheme =
                    (manualTheme ||
                        (systemTheme.matches ? 'dark' : 'light')) === 'dark'
                        ? 'light'
                        : 'dark';
                root.dataset.theme = manualTheme;
                syncThemeToggle();
                window.clearTimeout(transitionTimeout);
                transitionTimeout = window.setTimeout(
                    () => root.classList.remove('theme-transition'),
                    320,
                );
            });
            document.addEventListener('astro:page-load', syncThemeToggle);
            syncThemeToggle();
        </script>
        <main id="main">
            <section class="hero" id="top" aria-labelledby="page-title">
                <h1 id="page-title">
                    Front-end engineer specialising in complex web applications.
                </h1>
                <p class="hero-intro">
                    I work mostly with TypeScript and React. I enjoy the awkward
                    engineering problems, particularly figuring out how all the
                    moving parts should fit together, whether I'm building
                    something new or working with what's already there.
                </p>
                <div class="hero-bottom">
                    <p class="availability">
                        Available for freelance and contract work.
                    </p>
                    <a class="text-link" href="#contact">
                        Get in touch
                    </a>
                </div>
            </section>

            <section
                class="section"
                id="what-i-do"
                aria-labelledby="what-i-do-label"
            >
                <h2 class="section-label" id="what-i-do-label">
                    <span>01.</span> What I do
                </h2>
                <div class="entries">
                    <article class="entry">
                        <h3>Interfaces and workflows</h3>
                        <p>
                            I build interfaces where there's a lot going on
                            behind the scenes: complicated interactions,
                            business rules and systems that need to work
                            together.
                        </p>
                    </article>
                    <article class="entry">
                        <h3>Existing codebases</h3>
                        <p>
                            I'm quite happy getting stuck into code I didn't
                            write. I like figuring out what's worth keeping,
                            what needs improving and when it's better to start
                            again.
                        </p>
                    </article>
                    <article class="entry">
                        <h3>Architecture and performance</h3>
                        <p>
                            I like getting to the bottom of difficult problems,
                            whether that's an application that's become hard to
                            maintain, an architecture that's getting in the way,
                            or something that simply isn't performing as it
                            should.
                        </p>
                    </article>
                </div>
            </section>

            <section class="section" id="work" aria-labelledby="work-label">
                <h2 class="section-label" id="work-label">
                    <span>02.</span> Selected work
                </h2>
                <div class="experience-list">
                    <article class="experience">
                        <div class="experience-heading">
                            <h3>Kraken Phone</h3>
                            <p class="experience-org">
                                <a href="https://www.kraken.tech/">
                                    Kraken Technologies
                                </a>
                            </p>
                        </div>
                        <div class="experience-copy">
                            <p>
                                I led front-end engineering for Kraken's phone
                                system, used by agents during live customer
                                calls.
                            </p>
                            <p>
                                I designed and built a Flux-inspired approach to
                                keeping call state consistent across multiple
                                CRM browser tabs in real time.
                            </p>
                        </div>
                    </article>
                    <article class="experience">
                        <div class="experience-heading">
                            <h3>Reusable classifier library</h3>
                            <p class="experience-org">
                                <a href="https://www.zooniverse.org/">
                                    Zooniverse
                                </a>{' '}
                                / University of Oxford
                            </p>
                        </div>
                        <div class="experience-copy">
                            <p>
                                I started Zooniverse's reusable React classifier
                                library, building its initial viewers, state
                                stores and tests. I later worked on its layouts
                                and viewer selection, and integrated it into the
                                main application.
                            </p>
                            <a
                                class="source-link"
                                href="https://github.com/zooniverse/front-end-monorepo/commit/f8525ee6adc5cef0e88bb1bc4c67d170d7f2a6a2"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Classifier library foundation commit on GitHub (opens in a new tab)"
                            >
                                Source commit
                            </a>
                        </div>
                    </article>
                    <article class="experience">
                        <div class="experience-heading">
                            <h3>Configurable classification feedback</h3>
                            <p class="experience-org">
                                <a href="https://www.zooniverse.org/">
                                    Zooniverse
                                </a>{' '}
                                / University of Oxford
                            </p>
                        </div>
                        <div class="experience-copy">
                            <p>
                                Some Zooniverse projects needed to give
                                volunteers feedback on their answers. I built a
                                configurable system that let project teams
                                define their own rules, rather than needing
                                custom code for each project.
                            </p>
                            <a
                                class="source-link"
                                href="https://github.com/zooniverse/Panoptes-Front-End/pull/4191"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Classification feedback pull request on GitHub (opens in a new tab)"
                            >
                                Pull request
                            </a>
                        </div>
                    </article>
                </div>
            </section>

            <section class="section" id="about" aria-labelledby="about-label">
                <h2 class="section-label" id="about-label">
                    <span>03.</span> A bit about me
                </h2>
                <div class="about-copy">
                    <p>
                        I started out in journalism before finding my way into
                        software. I still like asking questions, understanding
                        how things work and getting the details right.
                    </p>
                    <p>I'm based in Oxfordshire, UK.</p>
                </div>
            </section>

            <section
                class="section"
                id="contact"
                aria-labelledby="contact-label"
            >
                <h2 class="section-label" id="contact-label">
                    <span>04.</span> Get in touch
                </h2>
                <div>
                    <div class="contact-links">
                        <!-- TODO: Add a direct email link once Roger supplies the address. -->
                        <a
                            class="contact-primary"
                            href="https://www.linkedin.com/in/roger-hutchings"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Get in touch on LinkedIn (opens in a new tab)"
                        >
                            Get in touch →
                        </a>
                        <a
                            class="contact-secondary"
                            href="https://github.com/rogerhutchings"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="GitHub profile (opens in a new tab)"
                        >
                            GitHub
                        </a>
                    </div>
                </div>
            </section>
        </main>

        <footer class="site-footer">
            <p>Roger Hutchings · Oxfordshire, UK</p>
            <a href="#top">Back to top</a>
        </footer>
    </div>
</SiteLayout>

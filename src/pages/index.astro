---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout>
  <div class="shell">
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Roger Hutchings, home">ROGER HUTCHIN.GS</a>
      <nav class="primary-nav" aria-label="Main navigation">
        <ul>
          <li><a href="#work">Work</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#contact">Contact</a></li>
          <li>
            <button class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false">
              <svg data-theme-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
              </svg>
              <svg data-theme-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden>
                <path d="M20.2 15.7A8.5 8.5 0 0 1 8.3 3.8 8.5 8.5 0 1 0 20.2 15.7Z" />
              </svg>
            </button>
          </li>
        </ul>
      </nav>
    </header>

    <script>
      const root = document.documentElement;
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
      let manualTheme = root.dataset.theme || null;
      let transitionTimeout;

      function syncThemeToggle() {
        const isDark = (manualTheme || (systemTheme.matches ? 'dark' : 'light')) === 'dark';
        document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
          button.setAttribute('aria-pressed', String(isDark));
          button.querySelector('[data-theme-icon="light"]')?.toggleAttribute('hidden', isDark);
          button.querySelector('[data-theme-icon="dark"]')?.toggleAttribute('hidden', !isDark);
        });
        if (manualTheme) {
          document.querySelector('#theme-color-light')?.setAttribute('media', isDark ? 'not all' : 'all');
          document.querySelector('#theme-color-dark')?.setAttribute('media', isDark ? 'all' : 'not all');
        }
      }

      systemTheme.addEventListener('change', syncThemeToggle);
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        if (!event.target.closest('.theme-toggle')) return;

        root.classList.add('theme-transition');
        manualTheme = (manualTheme || (systemTheme.matches ? 'dark' : 'light')) === 'dark' ? 'light' : 'dark';
        root.dataset.theme = manualTheme;
        syncThemeToggle();
        window.clearTimeout(transitionTimeout);
        transitionTimeout = window.setTimeout(() => root.classList.remove('theme-transition'), 320);
      });
      document.addEventListener('astro:page-load', syncThemeToggle);
      syncThemeToggle();
    </script>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="page-title">
        <h1 id="page-title">Software engineer and technical consultant.</h1>
        <p class="hero-intro">
          I work on complex web applications, mostly with TypeScript and React. I help teams untangle
          existing codebases, improve architecture and performance, and make technical decisions with
          confidence.
        </p>
        <div class="hero-bottom">
          <p class="availability">Open to selected freelance and consulting work.</p>
          <a class="text-link" href="#contact">Get in touch</a>
        </div>
      </section>

      <section class="section" id="work" aria-labelledby="work-label">
        <h2 class="section-label" id="work-label"><span>01.</span> I can help with</h2>
        <div class="entries">
          <article class="entry">
            <h3>Complex web applications</h3>
            <p>Building and improving React and TypeScript applications where the behaviour, workflows or integrations need careful thought.</p>
          </article>
          <article class="entry">
            <h3>Existing codebases</h3>
            <p>Understanding unfamiliar systems, simplifying awkward areas and making useful changes without a wholesale rewrite.</p>
          </article>
          <article class="entry">
            <h3>Architecture and performance</h3>
            <p>Investigating where a front end struggles, improving its structure and addressing the problems that matter to its users.</p>
          </article>
          <article class="entry">
            <h3>Technical leadership</h3>
            <p>Helping teams work through trade-offs, agree on a direction and turn decisions into practical engineering work.</p>
          </article>
        </div>
      </section>

      <section class="section" id="experience" aria-labelledby="experience-label">
        <h2 class="section-label" id="experience-label"><span>02.</span> Selected experience</h2>
        <div class="experience-list">
          <article class="experience">
            <h3>Kraken Technologies</h3>
            <p>Engineering work on complex operational software for the energy sector, drawing on experience in product development and technical leadership.</p>
          </article>
          <article class="experience">
            <h3>University of Oxford / Zooniverse</h3>
            <p>Building front-end interfaces for citizen-science projects, helping people contribute to scientific research through the web.</p>
          </article>
        </div>
      </section>

      <section class="section" id="about" aria-labelledby="about-label">
        <h2 class="section-label" id="about-label"><span>03.</span> A bit about me</h2>
        <p class="about-copy">
          My route into software began in journalism and took me through citizen science at the
          University of Oxford to product engineering at Kraken Technologies. I enjoy understanding
          complicated systems, making them clearer, and helping people build things that work well.
          I’m based in Oxfordshire, UK.
        </p>
      </section>

      <section class="section" id="contact" aria-labelledby="contact-label">
        <h2 class="section-label" id="contact-label"><span>04.</span> Get in touch</h2>
        <div>
          <p class="contact-copy">If you have a web application that needs building, improving or untangling, I’d be happy to hear about it.</p>
          <div class="contact-links">
            <!-- TODO: Add a direct email link once Roger supplies the address. -->
            <a class="contact-primary" href="https://www.linkedin.com/in/roger-hutchings" target="_blank" rel="noopener noreferrer" aria-label="Get in touch on LinkedIn (opens in a new tab)">Get in touch →</a>
            <a class="contact-secondary" href="https://github.com/rogerhutchings" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile (opens in a new tab)">GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>Roger Hutchings · Oxfordshire, UK</p>
      <a href="#top">Back to top</a>
    </footer>
  </div>
</SiteLayout>
